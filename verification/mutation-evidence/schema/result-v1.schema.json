{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "oregon.mutation-evidence.result/v1",
  "title": "Oregon Mutation Evidence Result V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "manifest_sha256", "repository", "source", "checkout", "toolchain", "ci", "authorities", "totals", "overall_status"],
  "properties": {
    "schema": {"const": "oregon.mutation-evidence.result/v1"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository": {"const": "zafersari82/Oregon"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "checkout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_clean", "after_clean"],
      "properties": {
        "before_clean": {"const": true},
        "after_clean": {"const": true}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust"],
      "properties": {"rust": {"const": "1.85.0"}}
    },
    "ci": {"type": "object"},
    "authorities": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/authority_result"}
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["killed", "total"],
      "properties": {
        "killed": {"const": 68},
        "total": {"const": 68}
      }
    },
    "overall_status": {"const": "passed"}
  },
  "$defs": {
    "authority_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runner", "runner_sha256", "command", "raw_log", "mutations", "totals"],
      "properties": {
        "id": {"enum": ["EA", "EE", "CS", "ER", "FS", "RJ"]},
        "runner": {"type": "string", "minLength": 1},
        "runner_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "command": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "raw_log": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filename", "sha256"],
          "properties": {
            "filename": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "mutations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/mutation_result"}
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["killed", "total"],
          "properties": {
            "killed": {"type": "integer", "minimum": 1},
            "total": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "mutation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "target", "killing_test", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^(EA|EE|CS|ER|FS|RJ)-[0-9]{3}$"},
        "name": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "killing_test": {"type": "string", "minLength": 1},
        "status": {"const": "killed"}
      }
    }
  }
}
