diff --git a/src/test/validation_block_tests.cpp b/src/test/validation_block_tests.cpp
index 5de8937..24e7e39 100644
--- a/src/test/validation_block_tests.cpp
+++ b/src/test/validation_block_tests.cpp
@@ -48,6 +48,55 @@ struct MinerTestingSetup : public RegTestingSetup {
 
 BOOST_FIXTURE_TEST_SUITE(validation_block_tests, MinerTestingSetup)
 
+
+BOOST_AUTO_TEST_CASE(oregon_founder_template_and_validation)
+{
+    auto mining{interfaces::MakeMining(m_node)};
+    BOOST_REQUIRE(mining);
+
+    const auto& consensus{Params().GetConsensus()};
+    const CScript founder_script{consensus.founderScriptPubKey.begin(), consensus.founderScriptPubKey.end()};
+
+    auto block_template{mining->createNewBlock({
+        .coinbase_output_script = CScript{} << OP_TRUE,
+    }, /*cooldown=*/false)};
+    BOOST_REQUIRE(block_template);
+
+    CBlock block{block_template->getBlock()};
+    const CTransaction& coinbase{*block.vtx[0]};
+
+    size_t founder_outputs{0};
+    for (const auto& output : coinbase.vout) {
+        if (output.nValue == consensus.founderAllocation && output.scriptPubKey == founder_script) {
+            ++founder_outputs;
+        }
+    }
+    BOOST_CHECK_EQUAL(founder_outputs, 1U);
+
+    const auto coinbase_template{block_template->getCoinbaseTx()};
+    BOOST_CHECK_EQUAL(coinbase_template.block_reward_remaining, consensus.nInitialSubsidy);
+    size_t required_founder_outputs{0};
+    for (const auto& output : coinbase_template.required_outputs) {
+        if (output.nValue == consensus.founderAllocation && output.scriptPubKey == founder_script) {
+            ++required_founder_outputs;
+        }
+    }
+    BOOST_CHECK_EQUAL(required_founder_outputs, 1U);
+
+    // A block at founder height without the mandatory founder output must be rejected.
+    CMutableTransaction missing_founder{coinbase};
+    std::erase_if(missing_founder.vout, [&](const CTxOut& output) {
+        return output.nValue == consensus.founderAllocation && output.scriptPubKey == founder_script;
+    });
+    block.vtx[0] = MakeTransactionRef(std::move(missing_founder));
+    block.hashMerkleRoot = BlockMerkleRoot(block);
+
+    std::string reason;
+    std::string debug;
+    BOOST_CHECK(!mining->checkBlock(block, {.check_pow = false}, reason, debug));
+    BOOST_CHECK_EQUAL(reason, "bad-founder-allocation");
+}
