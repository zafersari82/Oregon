+BOOST_AUTO_TEST_CASE(radium_founder_coinbase_policy_test)
+{
+    const auto chain_params = CreateChainParams(*m_node.args, ChainType::REGTEST);
+    const auto& consensus = chain_params->GetConsensus();
+
+    CMutableTransaction coinbase;
+    coinbase.vin.resize(1);
+    coinbase.vin[0].prevout.SetNull();
+    coinbase.vout.emplace_back(consensus.founderAllocation, CScript{consensus.founderScriptPubKey.begin(), consensus.founderScriptPubKey.end()});
+    const CTransaction valid{coinbase};
+    BOOST_CHECK(CheckFounderAllocation(valid, 1, consensus));
+
+    coinbase.vout[0].nValue -= 1;
+    BOOST_CHECK(!CheckFounderAllocation(CTransaction{coinbase}, 1, consensus));
+    coinbase.vout[0].nValue += 1;
+
+    coinbase.vout[0].scriptPubKey = CScript{} << OP_FALSE;
+    BOOST_CHECK(!CheckFounderAllocation(CTransaction{coinbase}, 1, consensus));
+
+    coinbase.vout[0].scriptPubKey = CScript{consensus.founderScriptPubKey.begin(), consensus.founderScriptPubKey.end()};
+    coinbase.vout.push_back(coinbase.vout[0]);
+    BOOST_CHECK(!CheckFounderAllocation(CTransaction{coinbase}, 1, consensus));
+
+    BOOST_CHECK(CheckFounderAllocation(CTransaction{coinbase}, 2, consensus));
+}
