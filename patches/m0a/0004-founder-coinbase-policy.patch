@@ -1851,6 +1851,21 @@ CAmount GetFounderAllocation(int nHeight, const Consensus::Params& consensusPara
     return nHeight == consensusParams.founderAllocationHeight ? consensusParams.founderAllocation : 0;
 }
 
+bool CheckFounderAllocation(const CTransaction& coinbase, int nHeight, const Consensus::Params& consensusParams)
+{
+    const CAmount founder_allocation{GetFounderAllocation(nHeight, consensusParams)};
+    if (founder_allocation == 0) return true;
+
+    const CScript founder_script{consensusParams.founderScriptPubKey.begin(), consensusParams.founderScriptPubKey.end()};
+    size_t matches{0};
+    for (const CTxOut& output : coinbase.vout) {
+        if (output.nValue == founder_allocation && output.scriptPubKey == founder_script) {
+            ++matches;
+        }
+    }
+    return matches == 1;
+}
