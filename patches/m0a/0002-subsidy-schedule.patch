+BOOST_AUTO_TEST_CASE(oregon_subsidy_schedule_test)
+{
+    const auto chain_params = CreateChainParams(*m_node.args, ChainType::REGTEST);
+    const auto& consensus = chain_params->GetConsensus();
+
+    BOOST_CHECK_EQUAL(GetBlockSubsidy(0, consensus), CAmount{0});
+    BOOST_CHECK_EQUAL(GetBlockSubsidy(1, consensus), CAmount{237'500'000});
+    BOOST_CHECK_EQUAL(GetBlockSubsidy(200'000, consensus), CAmount{237'500'000});
+    BOOST_CHECK_EQUAL(GetBlockSubsidy(200'001, consensus), CAmount{118'750'000});
+
+    CAmount mining_issuance{0};
+    for (int halving = 0; halving < 64; ++halving) {
+        const CAmount reward = consensus.nInitialSubsidy >> halving;
+        if (reward == 0) break;
+        mining_issuance += reward * consensus.nSubsidyHalvingInterval;
+    }
+    BOOST_CHECK_EQUAL(mining_issuance, CAmount{94'999'997'000'000});
+    BOOST_CHECK_EQUAL(mining_issuance + consensus.founderAllocation, CAmount{99'999'997'000'000});
+    BOOST_CHECK(mining_issuance + consensus.founderAllocation < consensus.nMaxSupply);
+}
